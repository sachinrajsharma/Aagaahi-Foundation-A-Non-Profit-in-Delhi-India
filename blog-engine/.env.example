# ─────────────────────────────────────────────────────────────────────────────
# BlogForge Engine — environment configuration
# Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4200
# Public base URL of THIS engine (dashboard + API + hosted blog when NOT proxied).
BASE_URL=http://localhost:4200
# Long random string — signs admin sessions. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=blogforge

# --- Admin bootstrap (created on first `npm run setup-db`) ---
ADMIN_NAME=Blog Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# --- Uploads ---
# Max upload size in MB, and allowed image types.
UPLOAD_MAX_MB=8

# --- Analytics ---
# How many days of raw page-view rows to keep (older rows pruned on boot).
TRACKING_RETENTION_DAYS=730

# --- AI writing assist (optional) — https://console.anthropic.com ---
# Leave blank to hide the AI buttons entirely.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
