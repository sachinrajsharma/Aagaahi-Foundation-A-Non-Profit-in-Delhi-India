<h1>Gallery</h1>
<p class="muted">Past events and programmes, grouped by focus area. What you publish here appears on the website's "Our work, in pictures" section.</p>
<% if (success) { %><div class="card" style="border-left:5px solid var(--green)"><%= success %></div><% } %>
<% if (!hasSharp) { %><div class="card" style="border-left:5px solid #f59e0b">Photos are stored exactly as uploaded because image compression is not installed on this server. Large phone photos will make the website slow: resize them to about 1400 pixels wide before uploading, or ask your developer to install <span class="mono">sharp</span>.</div><% } %>

<div class="card">
  <h2 style="margin-top:0">Add an event</h2>
  <form method="POST" action="/admin/gallery/events">
    <div class="row">
      <div><label>Event / programme name</label><input name="title" required maxlength="160" placeholder="e.g. Road Safety Drive"></div>
      <div><label>Focus area</label><input name="area" list="areas" maxlength="160" placeholder="e.g. Healthy Hygiene &amp; Wellbeing">
        <datalist id="areas"><% areaNames.forEach(function (a) { %><option value="<%= a %>"><% }); %></datalist></div>
    </div>
    <label>Short description</label><textarea name="description" rows="2" maxlength="1000" placeholder="One or two sentences about what happened"></textarea>
    <button class="btn" style="margin-top:12px">Create event, then add photos</button>
  </form>
</div>

<% if (!areas.length) { %><p class="muted">No events yet. Add your first one above.</p><% } %>
<% areas.forEach(function (a) { %>
  <h2 style="margin:24px 0 8px"><%= a.title %></h2>
  <div class="postcards">
    <% a.events.forEach(function (e) { %>
      <a class="postcard" href="/admin/gallery/<%= e.id %>" style="text-decoration:none;color:inherit">
        <% if (e.cover) { %><img src="<%= e.cover %>" alt="" loading="lazy" style="aspect-ratio:4/3;object-fit:cover"><% } else { %><div style="aspect-ratio:4/3;background:#f1f5f9;display:grid;place-items:center" class="muted">No photos yet</div><% } %>
        <div class="body"><b><%= e.title %></b>
          <div class="meta-row" style="font-size:12px"><span><%= e.photo_count %> photo<%= e.photo_count == 1 ? '' : 's' %></span><span class="badge <%= e.is_published ? 'on' : 'off' %>"><%= e.is_published ? 'published' : 'hidden' %></span></div>
        </div>
      </a>
    <% }); %>
  </div>
<% }); %>
