<p><a href="/admin/posts">← Posts</a></p>
<h1><%= post && post.id ? 'Edit post' : 'New post' %></h1>
<% if (error) { %><div class="notice err"><%= error %></div><% } %>

<form id="post-form" method="POST" action="/admin/posts">
  <% if (post && post.id) { %><input type="hidden" name="id" value="<%= post.id %>"><% } %>
  <input type="hidden" name="seo_score" id="seo_score" value="<%= (post&&post.seo_score)||'' %>">

  <div class="editor">
    <!-- Main column -->
    <div>
      <div class="card">
        <label for="f-title">Title</label>
        <input id="f-title" name="title" value="<%= (post&&post.title)||'' %>" placeholder="Your post headline" required>

        <label for="f-slug">URL slug</label>
        <input id="f-slug" name="slug" value="<%= (post&&post.slug)||'' %>" placeholder="auto-generated from title">

        <label>Content</label>
        <div class="toolbar">
          <button data-cmd="bold" title="Bold"><b>B</b></button>
          <button data-cmd="italic" title="Italic"><i>I</i></button>
          <button data-cmd="formatBlock" data-val="<h2>" title="Heading 2">H2</button>
          <button data-cmd="formatBlock" data-val="<h3>" title="Heading 3">H3</button>
          <button data-cmd="formatBlock" data-val="<p>" title="Paragraph">¶</button>
          <button data-cmd="insertUnorderedList" title="Bullet list">• List</button>
          <button data-cmd="insertOrderedList" title="Numbered list">1. List</button>
          <button data-cmd="formatBlock" data-val="<blockquote>" title="Quote">❝</button>
          <button data-cmd="createLink" title="Link">🔗</button>
          <button data-img title="Insert image">🖼️</button>
          <button data-cmd="removeFormat" title="Clear formatting">⌫</button>
          <% if (aiEnabled) { %><button type="button" id="ai-draft" title="AI draft">✨ AI draft</button><% } %>
        </div>
        <div id="editor" contenteditable="true"></div>
        <textarea id="content-input" name="content" hidden><%= (post&&post.content)||'' %></textarea>
        <input type="file" id="img-upload" accept="image/*" hidden>

        <label for="f-excerpt">Excerpt (optional — auto-generated if blank)</label>
        <textarea id="f-excerpt" name="excerpt" rows="2" placeholder="Short summary for cards and meta"><%= (post&&post.excerpt)||'' %></textarea>
      </div>

      <div class="card">
        <h2 style="margin-top:0">SEO &amp; meta</h2>
        <label>Focus keyphrase</label>
        <input name="focus_keyword" value="<%= (post&&post.focus_keyword)||'' %>" placeholder="the search term this post should rank for">
        <label>SEO title <span class="muted">(≤ 60 chars)</span></label>
        <input name="meta_title" value="<%= (post&&post.meta_title)||'' %>" maxlength="80">
        <label>Meta description
          <span class="muted">(120–155 chars)</span>
          <% if (aiEnabled) { %><button type="button" id="ai-meta" class="btn sm ghost" style="float:right;margin-top:-4px">✨ Suggest</button><% } %>
        </label>
        <textarea name="meta_desc" rows="2" maxlength="200"><%= (post&&post.meta_desc)||'' %></textarea>
        <div class="row">
          <div><label>Cover image URL</label><input name="cover_image" value="<%= (post&&post.cover_image)||'' %>"></div>
          <div><label>OG image URL (optional)</label><input name="og_image" value="<%= (post&&post.og_image)||'' %>"></div>
        </div>
        <label>Canonical URL (optional override)</label>
        <input name="canonical_url" value="<%= (post&&post.canonical_url)||'' %>" placeholder="leave blank for self-canonical">
        <label style="display:flex;align-items:center;gap:8px;margin-top:12px"><input type="checkbox" name="noindex" style="width:auto" <%= (post&&post.noindex)?'checked':'' %>> Ask search engines NOT to index this post</label>
      </div>
    </div>

    <!-- Side column: publish box + SEO assistant -->
    <div class="sidecol">
      <div class="card">
        <div class="row">
          <div><label>Status</label>
            <select name="status">
              <% var st=(post&&post.status)||'draft'; %>
              <option value="draft" <%= st==='draft'?'selected':'' %>>Draft</option>
              <option value="published" <%= st==='published'?'selected':'' %>>Published</option>
              <option value="scheduled" <%= st==='scheduled'?'selected':'' %>>Scheduled</option>
            </select>
          </div>
          <div><label>Category</label>
            <input name="category" list="cats" value="<%= (post&&post.category)||'' %>">
            <datalist id="cats"><% (categories||[]).forEach(function(c){ %><option value="<%= c %>"></option><% }); %></datalist>
          </div>
        </div>
        <div class="row">
          <div><label>Author</label><input name="author" value="<%= (post&&post.author)||'' %>" placeholder="<%= activeSite.default_author %>"></div>
          <div><label>Publish date (scheduled)</label><input type="datetime-local" name="published_at" value="<%= (post&&post.published_at)? new Date(post.published_at).toISOString().slice(0,16):'' %>"></div>
        </div>
        <button class="btn block" type="submit" style="margin-top:14px">Save post</button>
        <% if (post && post.slug) { %><a class="btn ghost block" style="margin-top:8px" href="/blog/<%= post.slug %>?site=<%= activeSite.slug %>" target="_blank">Preview</a><% } %>
      </div>

      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <h2 style="margin:0">SEO assistant</h2>
        </div>
        <div id="sa-scores" style="margin:10px 0"></div>
        <div id="sa-snippet"></div>
        <div class="sa-tabs">
          <button data-tab="seo" class="active" type="button">SEO</button>
          <button data-tab="read" type="button">Readability</button>
        </div>
        <div id="sa-body"></div>
      </div>
    </div>
  </div>
</form>

<script>
  window.BF_EDITOR = {
    siteHost: <%- JSON.stringify((activeSite.domain) || (activeSite.base_url||'').replace(/^https?:\/\//,'').replace(/\/.*$/,'') || 'example.com') %>,
    brand: <%- JSON.stringify(activeSite.brand_name || activeSite.name) %>,
    blogPath: <%- JSON.stringify(activeSite.blog_path || '/blog') %>
  };
</script>
<script src="/js/seo-assistant.js"></script>
<script src="/js/editor.js"></script>
