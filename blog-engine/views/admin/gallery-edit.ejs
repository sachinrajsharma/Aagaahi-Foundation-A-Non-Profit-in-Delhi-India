<p><a href="/admin/gallery">← Gallery</a></p>
<h1><%= event.title %></h1>
<% if (success) { %><div class="card" style="border-left:5px solid var(--green)"><%= success %></div><% } %>
<% if (error) { %><div class="card" style="border-left:5px solid var(--red)"><%= error %></div><% } %>

<div class="card">
  <h2 style="margin-top:0">Details</h2>
  <form method="POST" action="/admin/gallery/<%= event.id %>">
    <div class="row">
      <div><label>Event / programme name</label><input name="title" value="<%= event.title %>" required maxlength="160"></div>
      <div><label>Focus area</label><input name="area" value="<%= event.area %>" list="areas" maxlength="160">
        <datalist id="areas"><% areas.forEach(function (a) { %><option value="<%= a %>"><% }); %></datalist></div>
      <div style="flex:0 0 120px"><label>Order</label><input name="sort_order" type="number" value="<%= event.sort_order %>"></div>
    </div>
    <label>Short description</label><textarea name="description" rows="2" maxlength="1000"><%= event.description || '' %></textarea>
    <label>Introduction for the whole focus area <span class="muted">(optional; shown under the area heading)</span></label><input name="area_intro" value="<%= event.area_intro || '' %>" maxlength="400">
    <label style="font-weight:500;margin-top:10px"><input type="checkbox" name="is_published" value="1" style="width:auto" <%= event.is_published ? 'checked' : '' %>> Published (visible on the website)</label>
    <button class="btn" style="margin-top:12px">Save details</button>
  </form>
</div>

<div class="card">
  <h2 style="margin-top:0">Add photos</h2>
  <form method="POST" action="/admin/gallery/<%= event.id %>/photos" enctype="multipart/form-data">
    <div class="row">
      <div style="flex:2"><input type="file" name="photos" accept="image/*" multiple required></div>
      <div><input name="alt" placeholder="Describe the photo (optional)"></div>
      <div style="flex:0 0 auto"><button class="btn">Upload</button></div>
    </div>
    <p class="muted" style="margin:.5rem 0 0">You can pick up to 30 photos at once<%= hasSharp ? '; they are resized automatically so the website stays fast.' : '.' %></p>
  </form>
</div>

<div class="postcards">
  <% if (!photos.length) { %><p class="muted">No photos yet.</p><% } %>
  <% photos.forEach(function (p) { %>
    <div class="postcard">
      <img src="<%= p.thumb_url %>" alt="<%= p.alt || '' %>" loading="lazy" style="aspect-ratio:4/3;object-fit:cover">
      <div class="body">
        <form method="POST" action="/admin/gallery/<%= event.id %>/photos/<%= p.id %>">
          <input name="alt" value="<%= p.alt || '' %>" placeholder="Description" maxlength="300" style="font-size:12px">
          <div style="display:flex;gap:6px;margin-top:6px;align-items:center"><input name="sort_order" type="number" value="<%= p.sort_order %>" style="width:70px;font-size:12px" title="Order"><button class="btn sm ghost">Save</button></div>
        </form>
        <form method="POST" action="/admin/gallery/<%= event.id %>/photos/<%= p.id %>/delete" onsubmit="return confirm('Delete this photo?')" style="margin-top:6px"><button class="link" style="color:var(--red)">Delete photo</button></form>
      </div>
    </div>
  <% }); %>
</div>

<div class="card" style="margin-top:24px;border-color:#fecaca">
  <h2 style="margin-top:0">Delete this event</h2>
  <p class="muted">Removes the event and all of its photos for ever.</p>
  <form method="POST" action="/admin/gallery/<%= event.id %>/delete" onsubmit="return confirm('Delete this whole event and all its photos? This cannot be undone.')"><button class="btn red">Delete event</button></form>
</div>
